{
  "name": "automicvault",
  "version": "0.1.0",
  "description": "Read-only, localhost, live pixel-art office dashboard for pi-muster.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "automicvault": "bin/automicvault.mjs"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "!**/*.map"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run build -w @automicvault/web",
    "build:server": "node scripts/build-server.mjs",
    "start": "npm run build && node bin/automicvault.mjs",
    "demo": "npm run build && node bin/automicvault.mjs --demo",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -b packages/shared packages/server packages/web e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "chokidar": "^4.0.3",
    "hono": "^4.9.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
